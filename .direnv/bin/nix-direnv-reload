#!/usr/bin/env bash
set -e
if [[ ! -d "/home/nguyenhieu/projects/github/stardust-zip/Lab14-AI-Evaluation-Benchmarking" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/home/nguyenhieu/projects/github/stardust-zip/Lab14-AI-Evaluation-Benchmarking")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/home/nguyenhieu/projects/github/stardust-zip/Lab14-AI-Evaluation-Benchmarking" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/home/nguyenhieu/projects/github/stardust-zip/Lab14-AI-Evaluation-Benchmarking/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/home/nguyenhieu/projects/github/stardust-zip/Lab14-AI-Evaluation-Benchmarking/.envrc" "/home/nguyenhieu/projects/github/stardust-zip/Lab14-AI-Evaluation-Benchmarking/.direnv"/*.rc
